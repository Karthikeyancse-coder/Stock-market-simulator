# ============================================
# NEXUSAID ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your keys
# NEVER commit .env.local to GitHub!
# ============================================

# ============================================
# SUPABASE (Database + Auth)
# ============================================
# Get from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ============================================
# GOOGLE GEMINI AI (FREE - No credit card needed!)
# ============================================
# Get from: https://ai.google.dev/tutorials/setup
# Usage: Text classification, duplicate detection, need categorization
# FREE Tier: 60 requests/minute (plenty for you)
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# GOOGLE VISION API (FREE - $0 for 1000 requests/month!)
# ============================================
# Get from: https://console.cloud.google.com → Enable Vision API
# Usage: OCR - Extract text from survey photos
# FREE Tier: 1000 requests/month (perfect for MVP)
NEXT_PUBLIC_GOOGLE_VISION_API_KEY=your-vision-api-key-here
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# ============================================
# TWILIO (OPTIONAL - WhatsApp notifications)
# Get from: https://www.twilio.com → Console
# Usage: Send WhatsApp alerts to volunteers
# FREE Trial: $15 free credits (good for testing)
# ============================================
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+1234567890

# ============================================
# EMAIL SERVICE (Optional - Resend or SendGrid FREE tier)
# ============================================
# RESEND is easiest: https://resend.com (100 emails/day free)
RESEND_API_KEY=re_your-api-key-here

# OR SendGrid: https://sendgrid.com (100 emails/day free)
SENDGRID_API_KEY=SG.your-api-key-here

# ============================================
# SITE CONFIGURATION
# ============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NexusAid
NODE_ENV=development

# ============================================
# DATABASE (Supabase handles this, but for reference)
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/nexusaid

# ============================================
# OPTIONAL: Analytics (Completely Optional)
# ============================================
# Posthog: https://posthog.com (free tier available)
NEXT_PUBLIC_POSTHOG_KEY=phc_your-key

# Sentry: https://sentry.io (free tier available)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ============================================
# NOTES
# ============================================
# 1. Start with just Supabase + Gemini (FREE)
# 2. Add Vision API when doing OCR (FREE 1000/month)
# 3. Everything else is OPTIONAL
# 4. Total cost with all free tiers: $0/month
# 5. Never commit this file to GitHub!
# 6. Add .env.local to .gitignore
